# Femur frontend — copy to .env.local and adjust.
# Everything prefixed NEXT_PUBLIC_ is shipped to the browser. NEVER put secrets here.

# "mock" = in-memory sample data (development & design review only)
# "live" = talk to the NestJS backend at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_API_MODE=mock

# Backend origin (without /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this site (used for metadata/canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nira AI assistant (separate app)
NEXT_PUBLIC_NIRA_URL=https://nira.femurphysio.com

# Set to "production" on the production deployment. The build refuses to run
# with NEXT_PUBLIC_API_MODE != live when this is set.
# DEPLOY_ENV=production

# Show "Demo patient / Demo admin" buttons on /login (mock mode only, for internal review)
# NEXT_PUBLIC_SHOW_DEMO_LOGIN=true
